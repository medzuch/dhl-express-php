{
    "name": "medzuch/dhl-express-php",
    "description": "DHL Express API connector library",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10",
        "php-http/mock-client": "^1.6",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Medzuch\\DhlExpress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Medzuch\\DhlExpress\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src/",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit test suite",
        "analyse": "Run PHPStan static analysis",
        "check": "Run tests and static analysis"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
