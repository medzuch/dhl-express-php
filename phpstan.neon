includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 8
    phpVersion: 80300

    paths:
        - src

    excludePaths:
        - src/Support/Hydrator.php (?)  # may need dynamic typing, revisit; optional until file exists

    # Allow our own exception hierarchy to be thrown anywhere
    exceptions:
        check:
            missingCheckedExceptionInThrows: false
        implicitThrows: false

    # Strict type coverage (only options still valid in PHPStan 2.x;
    # iterable value type, generic class, and too-wide-return checks
    # are now enforced automatically at level 8).
    checkUninitializedProperties: true
    checkBenevolentUnionTypes: true
    checkImplicitMixed: true

    # Treat all phpDoc types as authoritative
    treatPhpDocTypesAsCertain: true

    # Report unmatched ignored errors (keeps neon clean)
    reportUnmatchedIgnoredErrors: true

    ignoreErrors: []